# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Secrets and local config
.env
.env.*
*.key

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
~$*

# Runtime state: the audit log is generated by running the app, never committed
audit/

# Raw model outputs are large and regenerable; score summaries and run metadata are kept
runs/*.jsonl

# Synthetic data is regenerable (same seed gives identical files):
#   python generate_cases.py --n 300 --seed 42 --out data
# The hand-labeled gold files are NOT regenerable, so they stay tracked.
data/*
!data/gold_*.jsonl

# Stray local copies
* - Copy*
CLAUDE1.md

# Logs
*.log

# If you clone Kev inside this folder, do not commit it
/kev/
